    <string name="feature_send_money_error_consent_revoked">Access to this account was withdrawn, so the payment was refused.</string>
    <string name="feature_send_money_error_token_expired">Your authorisation expired before the payment was sent. Authorise it again to continue.</string>
    <string name="feature_send_money_error_rate_limited">Your bank is busy right now. Wait a moment and try again.</string>
    <string name="feature_send_money_error_insufficient_funds">There is not enough money in this account to cover the payment. Nothing has been sent.</string>
    <string name="feature_send_money_error_network">The payment could not be sent. Check your connection and try again.</string>
    <string name="feature_send_money_error_reference">Reference %1$s</string>

