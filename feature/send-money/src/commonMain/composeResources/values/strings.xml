    <string name="feature_send_money_error_title">Payment could not be completed</string>
    <string name="feature_send_money_error_signature_missing">This app could not sign the payment instruction. Nothing has been sent. Please report the reference below.</string>
    <string name="feature_send_money_error_consent_not_authorised">The payment was not authorised at your bank. Authorise it to continue.</string>
    <string name="feature_send_money_error_consent_mismatch">The payment changed after you approved it, so your bank refused it. Start again to send it.</string>
    <string name="feature_send_money_error_outside_limits">This amount is outside your bank’s payment limits. Try a smaller amount.</string>
    <!-- Deliberately not "check the details": the details are right, the account just can't send
