<resources>
    <!-- One title serves the form and the review, which are two steps of one route — so it names the
         product rather than the step. "Schedule a payment" was left here by the copy of
         payments-schedule-payment this module started from, and named the wrong product outright. -->
    <string name="feature_payments_standing_order_screen_title">Set up standing order</string>
    <string name="feature_payments_standing_order_loading_a11y">Loading your accounts and payees</string>

    <string name="feature_payments_standing_order_rail_domestic">Domestic</string>
    <string name="feature_payments_standing_order_rail_international">International</string>

    <!-- Sits under the sticky action bar; the form itself is long enough to scroll past a header. -->
    <string name="feature_payments_standing_order_form_trust_note">Protected by UK Open Banking</string>

    <string name="feature_payments_standing_order_payer_bank_choice">Choose at my bank</string>
    <string name="feature_payments_standing_order_payer_bank_choice_supporting">Your bank will ask which account to pay from</string>
    <!-- The collapsed picker before anything has been chosen. An invitation, not a blank row: the
         payer is deliberately not preselected, so the empty state has to ask for a decision. -->
    <string name="feature_payments_standing_order_payer_unchosen">Choose an account</string>
    <string name="feature_payments_standing_order_payer_unchosen_supporting">Tap to pick where the money comes from</string>
    <string name="feature_payments_standing_order_payer_expand_a11y">Show the accounts you can pay from</string>
    <string name="feature_payments_standing_order_payer_collapse_a11y">Hide the accounts you can pay from</string>
    <!-- The payer account holds one currency and the amount is instructed in another, so the bank
         converts. %1$s is the instructed currency's code — it is no longer always GBP. -->
    <string name="feature_payments_standing_order_non_gbp_notice">This standing order is instructed in %1$s. Your bank will convert from this account and may charge for it.</string>

    <string name="feature_payments_standing_order_balance_available">%1$s available</string>
    <!-- Trailing the collapsed picker, where the label has to name what the figure is. -->
    <string name="feature_payments_standing_order_balance_available_prefixed">Available: %1$s</string>
    <string name="feature_payments_standing_order_debtor_heading">Pay from</string>
    <string name="feature_payments_standing_order_creditor_heading">Pay to</string>
    <string name="feature_payments_standing_order_selected_a11y">Selected</string>
    <!-- The read failed, which is a different statement from "you have no saved payees" — and the
         one the app used to make on a 403. The cause is not named: by the time it reaches the UI a
         refused permission and an expired token are the same state, and guessing would put words in
         the bank's mouth. Curly apostrophe, not \' — Compose Multiplatform renders the escape. -->

    <!-- The payee read is still running. Spoken only: the state itself is a shimmer, which has no
         text of its own, so without this a screen reader passes over the wait in silence and the
         next thing it announces is whatever the read turned out to be. -->
    <string name="feature_payments_standing_order_payees_loading_a11y">Loading your saved payees</string>

    <!-- The caption under the dashed avatar that opens the manual fields. "Pay", not "Add": nothing
         is saved here, so a label promising a new entry in the row would be describing an action the
         app cannot perform. -->
    <string name="feature_payments_standing_order_payee_pay_new">Pay new</string>
    <!-- Rail-neutral on purpose. The fields behind this are a sort code and account number on the
         domestic rail and an IBAN on the international one, so naming either one is wrong half the
         time. -->
    <string name="feature_payments_standing_order_manual_entry_a11y">Pay someone who is not a saved payee by entering their account details</string>
    <string name="feature_payments_standing_order_manual_name">Name on the account</string>
    <string name="feature_payments_standing_order_manual_sort_code">Sort code</string>
    <string name="feature_payments_standing_order_manual_sort_code_error">Enter a 6-digit sort code</string>
    <string name="feature_payments_standing_order_manual_account_number">Account number</string>
    <string name="feature_payments_standing_order_manual_account_number_error">Enter an 8-digit account number</string>
    <string name="feature_payments_standing_order_manual_confirm">Use these details</string>

    <!-- Pounds, not pence. The field used to be labelled "Amount in pence" and parsed minor units,
         so someone typing 250 meaning £250 sent £2.50. The wire format is unchanged — the draft
         still carries minor units — but nothing on screen asks for them any more. -->
    <string name="feature_payments_standing_order_amount_label">Amount</string>
    <string name="feature_payments_standing_order_amount_placeholder">0.00</string>
    <string name="feature_payments_standing_order_amount_available">You have %1$s available</string>
    <string name="feature_payments_standing_order_amount_error_not_a_number">Enter an amount like 250 or 250.00</string>
    <string name="feature_payments_standing_order_amount_error_too_many_decimals">Amounts go to two decimal places, like 250.99</string>
    <string name="feature_payments_standing_order_amount_error_not_positive">Enter an amount greater than zero</string>
    <string name="feature_payments_standing_order_amount_error_exceeds_balance">That is more than the balance available on this account</string>
    <!-- International only. The OBIE terms verbatim, not a gloss: "Recipient pays" / "I pay" were
         this app's invention, and neither OBIE nor HSBC documents any customer-facing wording, so
         paraphrasing was asserting a meaning nobody had defined. FollowingServiceLevel has no string
         because it is not offered — HSBC refuses it with UK.OBIE.Field.Invalid. -->
    <string name="feature_payments_standing_order_charges_heading">Charges</string>
    <string name="feature_payments_standing_order_charge_bearer_creditor">Paid by recipient</string>
    <string name="feature_payments_standing_order_charge_bearer_debtor">Paid by you</string>
    <string name="feature_payments_standing_order_charge_bearer_shared">Shared</string>

    <!-- HSBC's documented routing currencies. Resolved through a code-keyed map that falls back to
         the code itself, so an unlisted currency renders as itself rather than as another one. -->
    <string name="feature_payments_standing_order_currency_gbp">British Pound (GBP)</string>
    <string name="feature_payments_standing_order_currency_eur">Euro (EUR)</string>
    <string name="feature_payments_standing_order_currency_usd">US Dollar (USD)</string>
    <string name="feature_payments_standing_order_currency_aud">Australian Dollar (AUD)</string>
    <string name="feature_payments_standing_order_currency_cad">Canadian Dollar (CAD)</string>
    <string name="feature_payments_standing_order_currency_chf">Swiss Franc (CHF)</string>
    <string name="feature_payments_standing_order_currency_cny">Chinese Yuan (CNY)</string>
    <string name="feature_payments_standing_order_currency_hkd">Hong Kong Dollar (HKD)</string>
    <string name="feature_payments_standing_order_currency_sgd">Singapore Dollar (SGD)</string>
    <string name="feature_payments_standing_order_currency_nzd">New Zealand Dollar (NZD)</string>
    <string name="feature_payments_standing_order_currency_aed">UAE Dirham (AED)</string>
    <string name="feature_payments_standing_order_currency_czk">Czech Koruna (CZK)</string>
    <string name="feature_payments_standing_order_currency_dkk">Danish Krone (DKK)</string>
    <string name="feature_payments_standing_order_currency_nok">Norwegian Krone (NOK)</string>
    <string name="feature_payments_standing_order_currency_pln">Polish Zloty (PLN)</string>
    <string name="feature_payments_standing_order_currency_sar">Saudi Riyal (SAR)</string>
    <string name="feature_payments_standing_order_currency_sek">Swedish Krona (SEK)</string>
    <string name="feature_payments_standing_order_currency_zar">South African Rand (ZAR)</string>
    <string name="feature_payments_standing_order_currency_thb">Thai Baht (THB)</string>

    <!-- There were two strings here for the combination HSBC refuses: InstructedAmount.Currency
         must equal either the debtor account's currency or the currency of transfer. With one
         selector the second clause holds by construction, so the state they described is
         unreachable and a message for it could never be shown. -->

    <string name="feature_payments_standing_order_manual_iban">IBAN</string>
    <string name="feature_payments_standing_order_manual_iban_error">Enter a valid IBAN</string>

    <string name="feature_payments_standing_order_reference_label">Reference (optional)</string>
    <string name="feature_payments_standing_order_reference_helper">Max 35 characters</string>
    <string name="feature_payments_standing_order_review_button">Review standing order</string>

    <string name="feature_payments_standing_order_review_heading">Check this before you continue</string>
    <string name="feature_payments_standing_order_review_from_bank_choice">You’ll choose at your bank</string>
    <!-- No "Recipient receives" row on the review any more: the amount above it is already in the
         currency the recipient receives, so the row restated it. -->
    <string name="feature_payments_standing_order_review_charge_bearer">Charges</string>
    <string name="feature_payments_standing_order_review_from">From</string>
    <string name="feature_payments_standing_order_review_to">To</string>
    <string name="feature_payments_standing_order_review_reference">Reference</string>
    <string name="feature_payments_standing_order_review_reference_empty">None</string>
    <string name="feature_payments_standing_order_review_details_heading">Standing order details</string>
    <!-- Curly apostrophe, not \' — Compose Multiplatform does not collapse Android's escape and
         renders the backslash literally. Same trap as %% in a templated string. -->
    <string name="feature_payments_standing_order_review_auth_notice">You’ll approve this with your bank before any money moves.</string>

    <!-- "Setting up", not "sending": this stages a mandate, and no money moves at this step. -->
    <string name="feature_payments_standing_order_submitting_staging">Setting up your standing order</string>
    <string name="feature_payments_standing_order_submitting_awaiting">Waiting for you to authorise at your bank</string>
    <string name="feature_payments_standing_order_submitting_amount">%1$s to %2$s</string>
    <string name="feature_payments_standing_order_submitting_lock">Do not close the app until this finishes.</string>

    <string name="feature_payments_standing_order_error_title">Standing order could not be set up</string>
    <string name="feature_payments_standing_order_error_signature_missing">This app could not sign the standing order instruction. Nothing has been set up. Please report the reference below.</string>
    <string name="feature_payments_standing_order_error_consent_not_authorised">The standing order was not authorised at your bank. Authorise it to continue.</string>
    <string name="feature_payments_standing_order_error_consent_mismatch">The standing order changed after you approved it, so your bank refused it. Start again to set it up.</string>
    <string name="feature_payments_standing_order_error_outside_limits">This amount is outside your bank’s payment limits. Try a smaller amount.</string>
    <!-- Deliberately not "check the details": the details are right, the account just cannot carry
         a standing order. Applies to credit cards and Global Money wallets. -->
    <string name="feature_payments_standing_order_error_payer_not_supported">This account can’t be used for standing orders. Choose a different account to pay from.</string>
    <string name="feature_payments_standing_order_change_payer">Choose another account</string>
    <string name="feature_payments_standing_order_error_invalid_field">Your bank would not accept one of these details. Check them and try again.</string>
    <string name="feature_payments_standing_order_error_consent_revoked">Access to this account was withdrawn, so the standing order was refused.</string>
    <string name="feature_payments_standing_order_error_token_expired">Your authorisation expired before the standing order was set up. Authorise it again to continue.</string>
    <string name="feature_payments_standing_order_error_rate_limited">Your bank is busy right now. Wait a moment and try again.</string>
    <!-- No insufficient-funds message: no funds confirmation exists for standing orders on either
         rail, so the app never learns whether the money is there and must not imply that it does. -->
    <!-- Split in two because the bank cannot say which date it means: its single U003 recites all
         three date rules whichever was broken, and the customer has two dates to choose between. -->
    <string name="feature_payments_standing_order_error_first_date_refused">Your bank would not accept that start date. Choose another and try again.</string>
    <string name="feature_payments_standing_order_error_final_date_refused">Your bank would not accept that end date. It has to be after the first payment, at least two days away, and within a year.</string>
    <!-- The frequency is a closed list of what the bank accepts, so reaching this is a defect. The
         copy says so plainly rather than asking the customer to fix something they did not choose. -->
    <string name="feature_payments_standing_order_error_frequency_refused">Something went wrong setting up how often this repeats. Please try again.</string>
    <!-- U004/U005: a field this app got wrong. Says so plainly rather than blaming the customer's
         details, and offers no retry, because the same request would be built and refused again. -->
    <string name="feature_payments_standing_order_error_request_malformed">This standing order could not be set up because of a problem in the app. Nothing has been set up.</string>
    <string name="feature_payments_standing_order_error_scheme_not_supported">This account cannot be used for this kind of standing order. Try a different account.</string>
    <string name="feature_payments_standing_order_error_network">The standing order could not be set up. Check your connection and try again.</string>
    <string name="feature_payments_standing_order_error_reference">Reference %1$s</string>

    <string name="feature_payments_standing_order_retry">Try again</string>
    <string name="feature_payments_standing_order_reauthorise">Authorise again</string>
    <string name="feature_payments_standing_order_view_consents">View consents</string>
    <string name="feature_payments_standing_order_edit_amount">Change amount</string>

    <!-- The date, which is the whole of what this feature adds over an immediate payment. -->
    <string name="feature_payments_standing_order_date_heading">Schedule</string>
    <string name="feature_payments_standing_order_frequency_label">How often</string>
    <string name="feature_payments_standing_order_frequency_weekly">Weekly</string>
    <string name="feature_payments_standing_order_frequency_fortnightly">Fortnightly</string>
    <string name="feature_payments_standing_order_frequency_monthly">Monthly</string>
    <string name="feature_payments_standing_order_frequency_quarterly">Quarterly</string>
    <string name="feature_payments_standing_order_frequency_yearly">Yearly</string>
    <string name="feature_payments_standing_order_first_payment_label">First payment</string>
    <string name="feature_payments_standing_order_first_payment_empty">Choose a date</string>
    <!-- Two days, not one. The bank refuses a first transfer date that is today or tomorrow, and the
         picker greys both — but a greyed cell explains nothing, so the helper has to say the floor. -->
    <string name="feature_payments_standing_order_first_payment_helper">At least two days ahead, and within a year</string>
    <string name="feature_payments_standing_order_final_payment_label">Last payment</string>
    <!-- Empty is a real answer here, so the placeholder states what it means rather than prompting. -->
    <string name="feature_payments_standing_order_final_payment_empty">Not set — continues until you stop it</string>
    <string name="feature_payments_standing_order_final_payment_helper">After the first payment, and within a year</string>
    <string name="feature_payments_standing_order_final_payment_needs_first">Choose a first payment date first</string>
    <string name="feature_payments_standing_order_clear">Clear</string>
    <!-- The window is stated in words as well as greyed in the grid: a greyed cell is invisible to a
         screen reader, and the far bound is far enough away to be worth knowing before scrolling.
         It is rendered at body size, not in Material3's headline style, which is sized for a short
         selected date and turns a sentence this long into five lines that push the buttons over the
         grid. -->
    <string name="feature_payments_standing_order_date_picker_window">Select between %1$s and %2$s</string>
    <!-- UNBUILT. These four belong to the optional domestic recurring/final amount fields and the
         disabled-reason lines beside them. Everything behind them exists — `EnterRecurringAmount`
         and `EnterFinalAmount`, `recurringAmountEnabled`/`finalAmountEnabled`, the clearing on a
         rail switch, and `buildDraft` reading both into the draft — but no composable renders the
         fields, and `RECURRING_AMOUNT_FIELD`/`FINAL_AMOUNT_FIELD` are declared and never applied.
         So the domestic rail cannot currently vary its first, ongoing and final amounts, which the
         bank accepts and the mockups show.

         Kept rather than deleted precisely because they are unused: removing them would erase the
         only remaining trace that this half of the rail was specified and never wired up.
         Disabled-field reasons are facts about the rail, never errors — never in the error colour. -->
    <string name="feature_payments_standing_order_recurring_amount_label">Different ongoing amount (optional)</string>
    <string name="feature_payments_standing_order_final_amount_label">Different last payment (optional)</string>
    <!-- Stated before the customer commits, and again afterwards. Directing them to their bank is an
         obligation on the PISP for this product, not a courtesy: nothing here can change a mandate. -->
    <string name="feature_payments_standing_order_irreversible_title">You can’t change this here</string>
    <string name="feature_payments_standing_order_irreversible_body">A standing order can’t be changed or cancelled in this app. To change it later, use your bank’s app or online banking.</string>
    <!-- UNBUILT, same class as above. The spec states the review must say the schedule as one
         sentence ("Monthly, starting 20 August 2026, until you stop it"). The review instead shows a
         "Repeats" label over the date, so these two are unreferenced. Kept as the record of it. -->
    <string name="feature_payments_standing_order_schedule_open_ended">%1$s, starting %2$s, until you stop it.</string>
    <string name="feature_payments_standing_order_schedule_until">%1$s, starting %2$s, until %3$s.</string>
    <string name="feature_payments_standing_order_date_content_description">Payment date. %1$s</string>
    <string name="feature_payments_standing_order_date_picker_confirm">Confirm</string>
    <string name="feature_payments_standing_order_date_picker_cancel">Cancel</string>
    <string name="feature_payments_standing_order_change_date">Change date</string>

    <!-- The international rail declares no charge until after the standing order exists, so the form
         and the review both state the bearer and stop there. Naming a figure would be inventing one.
         Two wordings because the form's sits under a heading and the review's is a full sentence. -->
    <string name="feature_payments_standing_order_charges_caveat">Your bank confirms its own charge when the standing order is created</string>
    <string name="feature_payments_standing_order_review_charge_caveat">Your bank will confirm its own charge when it creates the standing order.</string>
    <string name="feature_payments_standing_order_review_bank_charge">Bank charge</string>
    <!-- The domestic rail does quote a per-payment charge, but only on the consent, which does not
    exist until Confirm is tapped. The row still has to appear: an omitted charge row reads as no
    charge. So it says when the figure arrives instead of inventing one. -->
    <string name="feature_payments_standing_order_review_charge_at_setup">Confirmed when you set this up</string>
    <string name="feature_payments_standing_order_review_sent_as">Sent as</string>

    <!-- The review hero states the date before the amount: when the money leaves is the decision
         being confirmed here, and it is the one thing an immediate payment never had to say. -->
    <string name="feature_payments_standing_order_review_scheduled_for">Repeats</string>
    <!-- The honesty panel. It must never say paid, sent or complete: nothing has moved, and the app
         cannot cancel what it has scheduled. -->
    <string name="feature_payments_standing_order_review_not_yet_made_title">No payment has been made yet</string>
    <!-- "Set up", never "paid": nothing has moved, and the first payment may be up to a year away. -->
    <string name="feature_payments_standing_order_review_not_yet_made_body">You are setting up a standing order. The first payment is due on %1$s.</string>
    <string name="feature_payments_standing_order_review_confirm">Confirm and continue</string>
    <string name="feature_payments_standing_order_review_edit">Edit</string>

    <!-- Waiting for the customer to come back from the bank. The way out is deliberate: returning
         through the task switcher delivers no callback, and without this the screen waits forever.
         "Cancel" is honest at THIS point only — nothing has been authorised, so no payment will be
         made. It must never be offered after approval, where the bank answers 405 to a delete of a
         standing-order consent and the app could not honour the word. -->
    <string name="feature_payments_standing_order_abandon_authorisation">Cancel</string>
</resources>
